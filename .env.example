# Environment variables for a game-amora deployment.
#
# This file names every variable the server reads. Copy it to `.env` for
# local development (the server loads `.env` automatically). For a real
# deployment on Railway, these values go into Railway's own Variables tab,
# not into a checked-in file. Railway injects them straight into the
# container. See docs/PROVISIONING.md for the full walkthrough, and
# docs/FORK_RUNBOOK.md for the long-form reasoning behind each one.
#
# `node scripts/fork-init.mjs` writes a filled-in `.env` for you: it
# generates the secrets on this list, fills in what you tell it about your
# village, and prints exactly which of the rest still need a human step.
#
# Your village's NAME, TAGLINE, COLOURS, LOGO and DOMAIN are not set here.
# Those live in the database and are set from Admin, Make This Yours, after
# your first login. This file only carries what the server needs before it
# can boot at all.

# ── REQUIRED: the server will not start, or nobody can ever log in, without these ──

# The MySQL connection string. On Railway this is a reference to your MySQL
# service, filled in automatically once you add one. Locally it points at
# your own database. Without it, the server refuses to start.
DATABASE_URL=

# Signs every member's session token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, the server makes up a new one on every restart, which logs out
# every member every time it restarts.
AUTH_TOKEN_SECRET=

# The one-time password used to create your own founder admin account
# through POST /api/admin/bootstrap. Pick anything; you use it once, then
# it stops working. Without it, nobody can ever become an admin.
ADMIN_PASSWORD=

# This village's own public web address, e.g. https://rionuevo.example.org.
# Without it, no cross-site browser request is allowed, and every link in
# an outgoing email (claim links, digests) falls back to whatever address
# the server happened to be reached at that moment.
FRONTEND_URL=

# ── STRONGLY RECOMMENDED: the platform runs without these, but important paths are closed ──

# The one email address that can always re-claim admin, even if every admin
# account gets demoted or locked out. Usually your own email. Without it,
# a village that loses every admin has no way back in.
BREAK_GLASS_ADMIN_EMAIL=

# 32 random bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts each member's own AI key and their agent-inbox signing secret.
# Without it, members cannot store either, and both features say so plainly
# rather than failing quietly. Rotating this key makes every stored member
# key unreadable, so set it once at provisioning and do not change it later.
MEMBER_SECRETS_KEY=

# The "From:" address on every email this village sends, e.g.
# "Rio Nuevo <hello@rionuevo.example.org>". Must be on a domain you have
# verified in Resend (see RESEND_API_KEY below). Without it, mail goes out
# under the platform's own fallback sender address instead of yours.
EMAIL_FROM=

# Turns on outgoing email at all: claim links, notifications, digests.
# Get a key at resend.com. Without it, every email is silently skipped
# (logged, never sent) and the platform never says so out loud.
#
# TRAP: Resend answers HTTP 200 for a sender domain you have not verified,
# and delivers nothing. Verify your domain at resend.com/domains (it walks
# you through the SPF + DKIM records) before you trust that any email is
# actually arriving. This can be settable from Admin, Integrations instead
# of here; either way, verify the domain first.
RESEND_API_KEY=

# How many proxies sit in front of this server. Every rate limit (sign-in
# throttling, checkout attempts, the abuse guard) is keyed on the address
# this number finds. 1 is correct on Railway. Too low trusts a forged
# header and lets one caller dodge every limit; too high buckets unrelated
# visitors together and throttles innocent people.
TRUSTED_PROXY_HOPS=1

# ── PAYMENTS: only needed if this village will sell anything with a card ──

# Your Stripe secret key (sk_live_... or sk_test_...) from your own Stripe
# account. Settable from Admin, Integrations instead of here. Without it,
# card checkout answers an honest 503 and the manual-payment path still
# grants credits.
STRIPE_SECRET_KEY=

# The signing secret for the ONE webhook endpoint this platform uses:
# POST /api/webhooks/stripe. Create the endpoint in your Stripe dashboard
# (Developers, Webhooks) pointing at https://<your-domain>/api/webhooks/stripe,
# subscribe it to checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, charge.refunded and charge.dispute.created, then paste its
# signing secret here. Settable from Admin, Integrations instead, which also
# shows you the exact URL to paste into Stripe. Without it, settlements are
# unverified or rejected and orders never credit.
STRIPE_WEBHOOK_SECRET=

# ── AI ASSISTANT (Maia): optional, the assistant simply hides without it ──

# Your own Anthropic API key. Powers guided proposals, the launch guide, the
# map concierge and call synthesis. Settable from Admin, Integrations
# instead of here. Without it, the assistant hides; every form and the rest
# of the platform keep working.
ANTHROPIC_API_KEY=

# Points the assistant at a stub instead of api.anthropic.com. Development
# and CI only. Leave this unset in production.
ANTHROPIC_BASE_URL=

# A ReGen-provisioned key this deployment may borrow until the village adds
# its own. Set only by whoever operates the ReGen-hosted deployment; leave
# unset on a self-hosted instance. There is deliberately no admin toggle
# for this one. Without it, no borrowing happens; the assistant is simply
# unavailable until the village adds its own key.
PLATFORM_ASSISTANT_KEY=

# Calls per day allowed against the borrowed key above. 0 means zero, never
# unlimited. Only meaningful alongside PLATFORM_ASSISTANT_KEY.
PLATFORM_ASSISTANT_DAILY_CAP=

# ── PER-MODULE INTEGRATIONS: optional, each module hides or 503s cleanly without its key ──

# Shared secret for POST /api/webhooks/riverside (the automation module).
# Settable from Admin, Integrations instead of here. This webhook fails
# closed: without a matching secret, every delivery is discarded with an
# inert 200, and the automation admin card shows a warning while it is
# unset.
RIVERSIDE_WEBHOOK_SECRET=

# Shared secret for POST /api/webhooks/mechanics-governance, how a Hypha
# vote's outcome comes home. Settable from Admin, Integrations instead of
# here. Fails closed: unset or mismatched means every delivery is discarded
# with an inert 200, and a human still applies verified outcomes by hand
# from the proposal card.
GOVERNANCE_HUB_SECRET=

# An Etherscan/Basescan API key (one free key from etherscan.io serves Base
# too) for Admin, Game Mechanics, Integrate DAO's token-address lookup.
# Settable from Admin, Integrations instead of here. Without it, that one
# lookup answers 409 with guidance; addresses can still be pasted by hand.
BASESCAN_API_KEY=

# Where member feedback gets relayed, if you want it to leave this village
# at all. Must be https:// and publicly resolvable. There is no default on
# purpose: without it, the relay does not run and everything stays local in
# Admin, Feedback, which is the safer starting state.
FEEDBACK_HUB_URL=

# An HTTPS endpoint (a Slack or Discord incoming webhook, a Sentry URL, your
# own collector) that receives a JSON alert when something crashes. Admins
# are always notified inside the app regardless. Without it, crashes are
# still logged and still alert admins in-app; nothing reaches an outside
# channel too.
ERROR_WEBHOOK_URL=

# Where a village is sent when the platform itself is the support desk for
# an Included module, or a lapsed Managed listing. Without it, the lapse
# message still says what keeps working, it just names nowhere to write.
PLATFORM_SUPPORT_URL=

# Same as above, as an email address, used when PLATFORM_SUPPORT_URL is unset.
PLATFORM_SUPPORT_EMAIL=

# ── LOCAL DEVELOPMENT AND TESTING ONLY: never set these on a real deployment ──

# A scratch MySQL connection string for the automated test suite. The test
# harness creates and drops its own uniquely-named schemas here; never
# point it at your real database.
#
# TRAP, verified: without it, roughly a third of the suite (every
# database-backed file) skips itself and `pnpm test` still exits 0. Nothing
# on screen says so unless you read the summary line's own skip count. A
# green run with this unset is not proof the platform works; it is proof
# a third of the suite did not run. Set this before trusting any test result.
TEST_DATABASE_URL=

# Overrides where uploaded files are stored. On Railway this is set for you
# by the volume mount at /app/data; you do not need to set it yourself.
DATA_DIR=

# The port the server listens on. Railway sets this for you automatically.
# Only useful for local development, where it defaults to 3000 if unset.
PORT=

# NOTE: `GEMINI_API_KEY` is a real variable, but it belongs to a one-off,
# run-by-hand art tool (`scripts/gen_avatars.py`), never to the server. Pass
# it inline on the command line when you use that script; do not put it here.
#
# NOTE: `JOURNEY_PASSWORD` shows up in older notes. It gated a screen that
# was retired; setting it now does nothing.
